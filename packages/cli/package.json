{
  "name": "sanctum-cli",
  "version": "0.6.1",
  "description": "Command-line client for the Sanctum secrets platform",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/RimoraStudio/sanctum.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "bin": {
    "sanctum": "dist/cli.js"
  },
  "main": "dist/cli.js",
  "files": [
    "dist",
    "skills",
    "README.md",
    "DEMO.md"
  ],
  "prepublishOnly": "npm run build",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "sanctum-sdk": "file:../sdk"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18"
  }
}
