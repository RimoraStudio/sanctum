{
  "name": "sanctum-sdk",
  "version": "0.3.1",
  "description": "TypeScript SDK for the Sanctum secrets platform",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/RimoraStudio/sanctum.git",
    "directory": "packages/sdk"
  },
  "files": [
    "dist"
  ],
  "prepublishOnly": "npm run build",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18"
  }
}
