{
  "name": "sanctum",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sanctum/sanctum.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/sanctum/sanctum/issues"
  },
  "homepage": "https://github.com/sanctum/sanctum#readme",
  "scripts": {
    "prepare": "husky install",
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:db": "docker compose -f docker-compose.dev.yml up -d db redis",
    "dev:api": "npm --prefix backend run dev",
    "dev:web": "npm --prefix frontend run dev",
    "db:migrate": "npm --prefix backend run migration:latest-dev",
    "db:seed": "npm --prefix backend run seed-dev",
    "typecheck:backend": "npm --prefix backend run type:check",
    "typecheck:frontend": "npm --prefix frontend run type:check"
  },
  "overrides": {
    "flatted": "^3.4.2",
    "minimatch": "^3.1.3",
    "js-yaml": "^4.1.1",
    "@babel/runtime": "^7.26.10"
  },
  "devDependencies": {
    "@types/uuid": "^9.0.7",
    "concurrently": "^9.0.0",
    "eslint": "^8.57.1",
    "husky": "^8.0.3"
  },
  "dependencies": {
    "@radix-ui/react-radio-group": "^1.1.3",
    "secrets.js-grempe": "^2.0.0"
  }
}
